# Copy to .env. The server reads it on start; real environment variables win.

# S3-compatible storage for file contents. Leave S3_BUCKET empty to store them on local disk.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
# Only if the endpoint is not of the form https://s3.<region>.example.com
S3_REGION=
# Give every deployment that shares the bucket its own prefix (dev/, prod/), or they delete each other's files.
S3_PREFIX=dev/

# Paddle subscriptions. Leave PADDLE_API_KEY empty for free drives.
# `coffer paddle-setup [https://your.domain]` creates the plans and prints the two values below.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# PADDLE_CHECKOUT_URL=https://pay.your.domain/pay
# PUBLIC_URL=https://your.domain

# Sign-up codes and lapse warnings by email, through Resend. Without these, emails are not verified.
RESEND_API_KEY=
MAIL_FROM=Coffer <no-reply@mail.your.domain>

# "Continue with Google" (optional). Authorised redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin console: a second listener (ADMIN_ADDR, :8081) to put behind its own hostname.
# Off while empty. Use a long random value, e.g. `openssl rand -base64 32`.
ADMIN_TOKEN=
# ADMIN_NOTIFY_EMAIL=you@your.domain
